# Garmin Connect (used only by wearable-mcp; tokens are cached in ./garmin-tokens)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=change-me

# Composio consumer API key (dashboard -> AI Clients). Used by Hermes MCP config.
COMPOSIO_API_KEY=

# Optional: Parallel API key (Search MCP works anonymously without it)
PARALLEL_API_KEY=

# Telegram bot for Hermes gateway
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (only this user can talk to the coach)
TELEGRAM_ALLOWED_USERS=

# Timezone used for planning
TZ=America/Los_Angeles
