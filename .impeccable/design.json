  "components": [
    {
      "name": "Scene Racks",
      "kind": "nav",
      "refersTo": "rack",
      "description": "Numbered scene signage; current scene is solid Tyvek.",
      "html": "<nav class=\"ds-racks\"><button class=\"ds-rack\"><b>1</b>Start</button><button class=\"ds-rack\" aria-current=\"step\"><b>2</b>Context</button><button class=\"ds-rack\"><b>3</b>Propose</button></nav>",
      "css": ":host{--asphalt:#1f2328;--asphalt-2:#272c32;--asphalt-3:#323840;--asphalt-4:#3f4650;--paint:#f3c22f;--paint-ink:#1a1608;--tyvek:#f3f2ec;--tyvek-ink:#15171a;--tyvek-mute:#585d63;--bag-blue:#2d5bcc;--bag-red:#c62b23;--text:#e9ebe6;--text-mute:#aab1b9;--hatch:#4a525c;--display:\"Big Shoulders\",Impact,sans-serif;--body:\"Atkinson Next\",system-ui,sans-serif;--mono:\"JetBrains Mono\",ui-monospace,monospace} .ds-racks{display:flex;gap:.55rem;background:var(--asphalt);padding:1rem} .ds-rack{display:flex;align-items:center;gap:.5rem;padding:.32rem .75rem .32rem .38rem;border:2px solid var(--asphalt-4);border-radius:6px;background:none;color:var(--text-mute);font-family:var(--display);font-weight:700;font-size:.95rem;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:background-color .25s cubic-bezier(.16,1,.3,1),color .25s,border-color .25s} .ds-rack b{display:grid;place-items:center;min-width:1.55rem;height:1.55rem;border-radius:4px;background:var(--asphalt-3);color:var(--text);font-weight:900;font-variant-numeric:tabular-nums} .ds-rack:hover{border-color:var(--text-mute);color:var(--text)} .ds-rack:focus-visible{outline:3px solid var(--paint);outline-offset:3px} .ds-rack[aria-current=\"step\"]{background:var(--tyvek);border-color:var(--tyvek);color:var(--tyvek-ink)} .ds-rack[aria-current=\"step\"] b{background:var(--tyvek-ink);color:var(--tyvek)}"
    },
    {
      "name": "Tyvek Data Tag",
      "kind": "card",
      "refersTo": "tag",
      "description": "The unit of data: value, note, source. Warn is paint, bad is red.",
      "html": "<div class=\"ds-tags\"><div class=\"ds-tag\"><div class=\"ds-val\">Sleep 86 · 8 h 22</div><div class=\"ds-note\">Best night of the week.</div><div class=\"ds-src\">Garmin · Last night</div></div><div class=\"ds-tag ds-warn\"><div class=\"ds-val\">Readiness 51</div><div class=\"ds-note\">Moderate.</div><div class=\"ds-src\">Garmin · Today</div></div><div class=\"ds-tag ds-bad\"><div class=\"ds-val\">Last week 9 h 26</div><div class=\"ds-note\">Over the 8-hour cap.</div><div class=\"ds-src\">wearable-mcp</div></div></div>",
      "css": ":host{--asphalt:#1f2328;--asphalt-2:#272c32;--asphalt-3:#323840;--asphalt-4:#3f4650;--paint:#f3c22f;--paint-ink:#1a1608;--tyvek:#f3f2ec;--tyvek-ink:#15171a;--tyvek-mute:#585d63;--bag-blue:#2d5bcc;--bag-red:#c62b23;--text:#e9ebe6;--text-mute:#aab1b9;--hatch:#4a525c;--display:\"Big Shoulders\",Impact,sans-serif;--body:\"Atkinson Next\",system-ui,sans-serif;--mono:\"JetBrains Mono\",ui-monospace,monospace} .ds-tags{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.85rem;background:var(--asphalt);padding:1rem} .ds-tag{position:relative;background:var(--tyvek);color:var(--tyvek-ink);border-radius:7px;padding:.85rem 1rem .8rem;box-shadow:0 2px 4px rgba(0,0,0,.28),0 10px 22px -12px rgba(0,0,0,.6);font-family:var(--body)} .ds-tag::before{content:\"\";position:absolute;top:.62rem;right:.7rem;width:.55rem;height:.55rem;border-radius:50%;background:var(--asphalt);opacity:.85} .ds-val{font-family:var(--display);font-weight:800;font-size:2rem;line-height:1.02;text-transform:uppercase;padding-right:1rem;font-variant-numeric:tabular-nums} .ds-note{font-size:.92rem;color:var(--tyvek-mute);margin-top:.2rem} .ds-src{font-family:var(--display);font-weight:700;font-size:.82rem;letter-spacing:.1em;text-transform:uppercase;color:var(--tyvek-mute);margin-top:.55rem;padding-top:.4rem;border-top:1px dashed currentColor} .ds-warn{background:var(--paint);color:var(--paint-ink)} .ds-warn .ds-src,.ds-warn .ds-note{color:#5a4a10} .ds-bad{background:var(--bag-red);color:#fff} .ds-bad .ds-src,.ds-bad .ds-note{color:#ffd9d5}"
    },
    {
      "name": "Chat Bubbles",
      "kind": "custom",
      "refersTo": "bubble-agent",
      "description": "Human on Tyvek, agent on cobalt; speaker-side corner tightened.",
      "html": "<div class=\"ds-chat\"><p class=\"ds-msg ds-me\">Plan my week.</p><p class=\"ds-msg ds-olav\"><span class=\"ds-who\">Olav</span>Monday is rest after Sunday's 4-hour ride.</p></div>",
      "css": ":host{--asphalt:#1f2328;--asphalt-2:#272c32;--asphalt-3:#323840;--asphalt-4:#3f4650;--paint:#f3c22f;--paint-ink:#1a1608;--tyvek:#f3f2ec;--tyvek-ink:#15171a;--tyvek-mute:#585d63;--bag-blue:#2d5bcc;--bag-red:#c62b23;--text:#e9ebe6;--text-mute:#aab1b9;--hatch:#4a525c;--display:\"Big Shoulders\",Impact,sans-serif;--body:\"Atkinson Next\",system-ui,sans-serif;--mono:\"JetBrains Mono\",ui-monospace,monospace} .ds-chat{display:flex;flex-direction:column;gap:.75rem;background:var(--asphalt);padding:1rem;font-family:var(--body)} .ds-msg{max-width:92%;margin:0;padding:.8rem 1.05rem;border-radius:14px;font-size:1.14rem;line-height:1.42} .ds-me{align-self:flex-end;background:var(--tyvek);color:var(--tyvek-ink);border-bottom-right-radius:4px;font-weight:600} .ds-olav{align-self:flex-start;background:var(--bag-blue);color:#fff;border-bottom-left-radius:4px} .ds-who{display:block;font-family:var(--display);font-weight:800;letter-spacing:.08em;font-size:.85rem;text-transform:uppercase;color:#c9d6ff;margin-bottom:.15rem}"
    },
    {
      "name": "Tool Output",
      "kind": "custom",
      "refersTo": "tool-output",
      "description": "Literal tool call in mono with one highlighted span.",
      "html": "<div class=\"ds-wrap\"><p class=\"ds-tool\"><span class=\"ds-by\">wearable-mcp</span> propose_plan<br><span class=\"ds-hl\">propose_plan → <span class=\"ds-ok\">ok</span> · 5 h 10 of 8 h · 0 hard</span></p><p class=\"ds-tool\"><span class=\"ds-hl\"><span class=\"ds-by\">wearable-mcp</span> propose_plan → <span class=\"ds-no\">ok: false</span> · 2 violations</span></p></div>",
      "css": ":host{--asphalt:#1f2328;--asphalt-2:#272c32;--asphalt-3:#323840;--asphalt-4:#3f4650;--paint:#f3c22f;--paint-ink:#1a1608;--tyvek:#f3f2ec;--tyvek-ink:#15171a;--tyvek-mute:#585d63;--bag-blue:#2d5bcc;--bag-red:#c62b23;--text:#e9ebe6;--text-mute:#aab1b9;--hatch:#4a525c;--display:\"Big Shoulders\",Impact,sans-serif;--body:\"Atkinson Next\",system-ui,sans-serif;--mono:\"JetBrains Mono\",ui-monospace,monospace} .ds-wrap{display:grid;gap:.6rem;justify-items:start;background:var(--asphalt);padding:1rem} .ds-tool{margin:0;font-family:var(--mono);font-weight:500;font-size:.9rem;line-height:1.5;background:var(--asphalt-2);color:var(--text-mute);border:1px solid var(--asphalt-4);border-radius:6px;padding:.45rem .7rem} .ds-by{color:var(--text)} .ds-hl{color:var(--text);background:linear-gradient(transparent 58%,rgba(243,194,47,.45) 58%)} .ds-ok{color:var(--paint)} .ds-no{color:#ff8a82}"
    },
    {
      "name": "Calendar Chips",
      "kind": "chip",
      "refersTo": "chip-busy",
      "description": "Busy time hatched, coach events cobalt, rest as a bare label.",
      "html": "<div class=\"ds-chips\"><span class=\"ds-chip ds-busy\">18:00–21:00 Event</span><span class=\"ds-chip ds-coach\"><i>[Coach]</i> Easy run 40′</span><span class=\"ds-chip ds-rest\">Rest</span></div>",
      "css": ":host{--asphalt:#1f2328;--asphalt-2:#272c32;--asphalt-3:#323840;--asphalt-4:#3f4650;--paint:#f3c22f;--paint-ink:#1a1608;--tyvek:#f3f2ec;--tyvek-ink:#15171a;--tyvek-mute:#585d63;--bag-blue:#2d5bcc;--bag-red:#c62b23;--text:#e9ebe6;--text-mute:#aab1b9;--hatch:#4a525c;--display:\"Big Shoulders\",Impact,sans-serif;--body:\"Atkinson Next\",system-ui,sans-serif;--mono:\"JetBrains Mono\",ui-monospace,monospace} .ds-chips{display:flex;flex-wrap:wrap;gap:.3rem;background:var(--asphalt);padding:1rem} .ds-chip{font-family:var(--display);font-weight:700;font-size:.94rem;letter-spacing:.03em;line-height:1.1;padding:.24rem .5rem;border-radius:5px;white-space:nowrap;font-variant-numeric:tabular-nums} .ds-busy{color:var(--text);background:repeating-linear-gradient(135deg,var(--asphalt-3) 0 6px,var(--asphalt-2) 6px 12px);border:1px solid var(--hatch)} .ds-coach{background:var(--bag-blue);color:#fff} .ds-coach i{font-style:normal;color:#c9d6ff} .ds-rest{color:var(--text-mute);letter-spacing:.08em;text-transform:uppercase;padding-left:0}"
    },
    {
      "name": "Review States",
      "kind": "chip",
      "refersTo": "state-done",
      "description": "Planned vs actual: done Tyvek, missed red, unplanned dashed.",
      "html": "<div class=\"ds-states\"><span class=\"ds-state ds-done\">Done</span><span class=\"ds-state ds-missed\">Missed</span><span class=\"ds-state ds-unplanned\">Unplanned</span></div>",
      "css": ":host{--asphalt:#1f2328;--asphalt-2:#272c32;--asphalt-3:#323840;--asphalt-4:#3f4650;--paint:#f3c22f;--paint-ink:#1a1608;--tyvek:#f3f2ec;--tyvek-ink:#15171a;--tyvek-mute:#585d63;--bag-blue:#2d5bcc;--bag-red:#c62b23;--text:#e9ebe6;--text-mute:#aab1b9;--hatch:#4a525c;--display:\"Big Shoulders\",Impact,sans-serif;--body:\"Atkinson Next\",system-ui,sans-serif;--mono:\"JetBrains Mono\",ui-monospace,monospace} .ds-states{display:flex;gap:.6rem;background:var(--asphalt-2);padding:1rem} .ds-state{display:inline-flex;align-items:center;font-family:var(--display);font-weight:800;letter-spacing:.08em;text-transform:uppercase;font-size:.95rem;padding:.2rem .6rem;border-radius:4px} .ds-done{background:var(--tyvek);color:var(--tyvek-ink)} .ds-missed{background:var(--bag-red);color:#fff} .ds-unplanned{border:2px dashed var(--text-mute);color:var(--text);padding:.1rem .5rem}"
    },
    {
      "name": "Yellow Card",
      "kind": "custom",
      "refersTo": "yellow-card",
      "description": "The official's card: snaps onto the line when code blocks a plan.",
      "html": "<div class=\"ds-stage\"><div class=\"ds-card\"><h3>Blocked by code</h3><ul><li><b>Sat · 3-hour ride</b><span>Longest session allowed is 2 h 30.</span><code>max_session_minutes: 150</code></li></ul></div></div>",
      "css": ":host{--asphalt:#1f2328;--asphalt-2:#272c32;--asphalt-3:#323840;--asphalt-4:#3f4650;--paint:#f3c22f;--paint-ink:#1a1608;--tyvek:#f3f2ec;--tyvek-ink:#15171a;--tyvek-mute:#585d63;--bag-blue:#2d5bcc;--bag-red:#c62b23;--text:#e9ebe6;--text-mute:#aab1b9;--hatch:#4a525c;--display:\"Big Shoulders\",Impact,sans-serif;--body:\"Atkinson Next\",system-ui,sans-serif;--mono:\"JetBrains Mono\",ui-monospace,monospace} .ds-stage{background:var(--asphalt);padding:2rem} .ds-card{max-width:30rem;background:var(--paint);color:var(--paint-ink);border-radius:12px;padding:1.5rem 1.6rem 1.3rem;box-shadow:0 6px 12px rgba(0,0,0,.3),0 30px 60px -18px rgba(0,0,0,.75);transform:rotate(-4deg);font-family:var(--body);transition:transform .45s cubic-bezier(.16,1,.3,1)} .ds-card:hover{transform:rotate(-14deg) scale(1.05)} .ds-card h3{margin:0;font-family:var(--display);font-weight:900;font-size:3.4rem;line-height:.86;text-transform:uppercase} .ds-card ul{list-style:none;margin:.85rem 0 0;padding:0} .ds-card li{display:grid;gap:.2rem;padding:.6rem .75rem .55rem;background:rgba(26,22,8,.1);border-radius:6px} .ds-card b{font-family:var(--display);font-weight:900;font-size:1.55rem;line-height:1;text-transform:uppercase} .ds-card code{font-family:var(--mono);font-weight:500;font-size:.84rem;color:#5a4a10}"
    },
    {
      "name": "Repo Link",
