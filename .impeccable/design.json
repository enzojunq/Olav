      "css": ":host{--asphalt:#1f2328;--asphalt-2:#272c32;--asphalt-3:#323840;--asphalt-4:#3f4650;--paint:#f3c22f;--paint-ink:#1a1608;--tyvek:#f3f2ec;--tyvek-ink:#15171a;--tyvek-mute:#585d63;--bag-blue:#2d5bcc;--bag-red:#c62b23;--text:#e9ebe6;--text-mute:#aab1b9;--hatch:#4a525c;--display:\"Big Shoulders\",Impact,sans-serif;--body:\"Atkinson Next\",system-ui,sans-serif;--mono:\"JetBrains Mono\",ui-monospace,monospace} .ds-stage2{background:var(--asphalt);padding:1.5rem} .ds-repo{font-family:var(--mono);font-weight:500;font-size:1.15rem;color:var(--tyvek-ink);background:var(--tyvek);padding:.55rem .9rem;border-radius:6px;text-decoration:none;transition:background-color .25s cubic-bezier(.16,1,.3,1)} .ds-repo:hover{background:var(--paint)} .ds-repo:focus-visible{outline:3px solid var(--paint);outline-offset:3px}"
